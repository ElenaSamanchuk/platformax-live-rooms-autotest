# Скопируйте в .env и заполните. .env не коммитить.
# Адрес тестовой школы, например https://<школа>.test.<домен>
BASE_URL=

# Владелец школы — ведущий встреч
OWNER_EMAIL=
OWNER_PASSWORD=

# Ученик A — БЕЗ продукта PRODUCT_ID (нужен для H-1)
STUDENT_A_EMAIL=
STUDENT_A_PASSWORD=
# Ученик B — с продуктом PRODUCT_ID
STUDENT_B_EMAIL=
STUDENT_B_PASSWORD=

# Сотрудник с правами «только просмотр» (необязательно)
STAFF_VIEW_EMAIL=
STAFF_VIEW_PASSWORD=

# Продукт для «Ограниченного доступа» (H-1), название как в выпадающем списке
PRODUCT_ID=
PRODUCT_TITLE=

# QA-режим без паролей учеников: сохранённая сессия владельца (Playwright storageState),
# ученики и сотрудник заходят через «Войти как». Пароли учеников тогда оставить пустыми.
OWNER_STORAGE_STATE=
